# Read-only Alpaca market data credentials for `npm run ingest:alpaca-iex`.
ALPACA_DATA_API_KEY_ID=
ALPACA_DATA_API_SECRET_KEY=
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_SYMBOLS=SPY

# Alpaca Trading API credentials. Defaults to paper trading.
ALPACA_TRADING_API_KEY_ID=
ALPACA_TRADING_API_SECRET_KEY=
ALPACA_TRADING_MODE=paper
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets

# Live operations snapshot controls for `npm run live-ops:snapshot`.
LIVE_OPS_DAY_STARTING_EQUITY=
LIVE_OPS_DAY_FEES_PAID=0
LIVE_OPS_MAX_DAILY_LOSS=100
LIVE_OPS_MAX_GROSS_EXPOSURE_PCT=25
LIVE_TRADING_ENABLED=false
LIVE_OPERATOR_CONFIRMED=false
LIVE_KILL_SWITCH_ARMED=true
LIVE_STOP_AFTER_BREAK_EVEN=true
LIVE_REQUIRE_PRIOR_BREAK_EVEN_AUDIT=false
ALERT_WEBHOOK_URL=

# One guarded trading cycle. Keep small until paper behavior is verified.
# npm run paper-trading:check -- --symbols SPY,AAPL
# npm run live-trading:cycle -- --symbol SPY --strategy buy-and-hold --notional 25 --history-dir reports/live-ops-history
# Bounded multi-symbol paper coordinator. Keep iterations low while validating behavior.
# npm run paper-trading:coordinator -- --symbols SPY,AAPL --strategy buy-and-hold --notional 25 --iterations 2 --interval-ms 60000 --market-session regular --max-candle-age-ms 900000 --max-history-candles 100 --max-executions-per-run 2 --state reports/paper-trading.sqlite --history-dir reports/live-ops-history
# Use --market-session off only for intentional after-hours dashboard validation.
# Multi-candle strategies bootstrap bounded historical IEX bars, then append latest bars.
# npm run paper-trading:coordinator -- --symbols SPY,AAPL --strategy moving-average-crossover --strategy-param shortWindow=2 --strategy-param longWindow=5 --strategy-param minConfidence=0.01 --sizing allocation --target-allocation-pct 0.0025 --max-order-notional 50 --max-position-notional 250 --max-executions-per-run 2 --iterations 5 --interval-ms 60000 --history-dir reports/live-ops-history
# Allocation-sized coordinator pass.
# npm run paper-trading:coordinator -- --symbols SPY,AAPL --sizing allocation --target-allocation-pct 0.0025 --max-order-notional 50 --max-position-notional 250 --history-dir reports/live-ops-history
# Weighted allocation pass.
# npm run paper-trading:coordinator -- --symbols SPY,AAPL,MSFT --sizing allocation --allocation-weights SPY=0.0025,AAPL=0.0015 --target-allocation-pct 0.001 --max-total-allocation-pct 0.01 --history-dir reports/live-ops-history
# Flatten open positions through the same safety gateway.
# npm run live-trading:flatten -- --history-dir reports/live-ops-history

# Audit one or more saved daily snapshots.
# npm run break-even:audit -- reports/live-ops-2026-06-19.json
